<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILD ONLY (resource merging picks this over src/main's version for
  the debug variant, same mechanism the app already relies on for its
  ".debug" applicationIdSuffix and dev launcher icon). Permits cleartext
  HTTP everywhere so TrackAppSyncUseCase (core/usecase/TrackAppSyncUseCase.kt)
  can be pointed at a plain http local dev server, e.g.
  http://192.168.1.220:3031 while iterating on the trackapp side of the
  sync feature. A real deployment (release/beta/oss) has no such exception,
  see src/main's own copy of this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
